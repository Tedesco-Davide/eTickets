@model IEnumerable<Actor>

@{
    ViewData["Title"] = "List of Actors";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <table class="table w-100">
            <caption>List of Actors</caption>
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.ProfilePictureURL)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.FullName)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.Bio)</th>
                    <th scope="col">
                        Actions
                        <div class="text-white float-end d-flex">
                            <a type="submit" asp-controller="Actors" asp-action="Create" class="btn btn-success"
                               style="line-height: 0; padding: 3px 15px;">
                                <span class="bi bi-plus-circle"> Add New</span>
                            </a>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @foreach (var actor in Model)
                {
                    <tr>
                        <td scope="row">
                            @Html.DisplayFor(model => actor.Id)
                        </td>
                        <td>
                            <img class="rounded-circle" src="@actor.ProfilePictureURL" alt="@actor.FullName" style="max-width: 150px;" />
                        </td>
                        <td>
                            @Html.DisplayFor(model => actor.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(model => actor.Bio)
                        </td>
                        <td>
                            <a class="btn btn-outline-primary">
                                <i class="bi bi-pencil-square">Edit </i>
                            </a> |
                            <a class="btn btn-outline-info">
                                <i class="bi bi-eye">Details </i>
                            </a> |
                            <a class="btn btn-danger text-white">
                                <i class="bi bi-trash">Delete </i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>