@model Actor

@{
    ViewData["Title"] = "Delete Actor";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <p>
            <h1>
                Delete confirmation for @Model.FullName
            </h1>
        </p>
        <div class="row justify-content-center">
            <div class="col-md-8 d-grid gap-3">
                <div class="text-center">
                    <img class="rounded-circle" id="ProfilePicturePreview" style="width: 150px; height: 150px;" />
                </div>
                <div>
                    <label asp-for="ProfilePictureURL" class="form-label"></label>
                    <input asp-for="ProfilePictureURL" class="form-control" readonly />
                    <span asp-validation-for="ProfilePictureURL" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" readonly />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Bio" class="form-label"></label>
                    <input asp-for="Bio" class="form-control" readonly />
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>
                <div>
                    <form asp-action="Delete">
                        <a class="btn btn-outline-secondary" asp-action="Index">
                            Show All
                        </a>
                        <input type="hidden" asp-for="Id" />
                        <input type="submit" value="Confirm" class="btn btn-danger float-end" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var output = document.getElementById("ProfilePicturePreview");
            output.src = $("#ProfilePictureURL").val();
        })
    </script>
}