@model IEnumerable<Producer>

@{
    ViewData["Title"] = "List of Producers";
}

<h1>Welcome to Producers view</h1>

<div class="row justify-content-center">
    <div class="col-md-8">
        <table class="table w-100">
            <caption>List of Producers</caption>
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.ProfilePictureURL)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.FullName)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.Bio)</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @foreach (var producer in Model)
                {
                    <tr>
                        <td scope="row">
                            @Html.DisplayFor(model => producer.Id)
                        </td>
                        <td>
                            <img class="rounded-circle" src="@producer.ProfilePictureURL" alt="@producer.FullName" style="max-width: 150px;" />
                        </td>
                        <td>
                            @Html.DisplayFor(model => producer.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(model => producer.Bio)
                        </td>
                        <td>
                            <a class="btn btn-outline-primary">
                                <i class="bi bi-pencil-square">Edit </i>
                            </a> |
                            <a class="btn btn-outline-info">
                                <i class="bi bi-eye">Details </i>
                            </a> |
                            <a class="btn btn-danger text-white">
                                <i class="bi bi-trash">Delete </i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>